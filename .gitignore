models/*.pkl
models/*.zip
models/*.pt
models/*.pth
models/*.onnx

# Blender backups and render intermediates
blender/*.blend1
blender/sim_episode_frames/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tooling
.claude/
